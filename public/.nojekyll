<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <script>
      // GitHub Pages SPA redirect script
      // Store the path in sessionStorage and redirect to index
      sessionStorage.setItem('redirect', location.pathname.slice(0, -1) + location.search + location.hash);
      location.replace(location.origin + location.pathname.split('/').slice(0, -1).join('/'));
    </script>
  </head>
  <body></body>
</html>
